# ===========================================
# 医疗问诊练习系统 - 配置文件
# ===========================================
# 复制这个文件为 .env，然后填入你的配置
# cp .env.example .env

# ===========================================
# AI API 配置（必填）
# ===========================================

# API 端点地址
# 支持 DeepSeek、OpenAI、Ollama 或任何兼容 OpenAI API 格式的服务
AI_API_URL=https://api.deepseek.com/v1/chat/completions

# API 密钥
# DeepSeek: sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OpenAI: sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Ollama: ollama（本地部署时使用）
AI_API_KEY=your_api_key_here

# 模型名称
# DeepSeek: deepseek-chat, deepseek-reasoner
# OpenAI: gpt-4, gpt-3.5-turbo
# Ollama: qwen2.5, llama3, etc.
AI_MODEL=deepseek-chat

# ===========================================
# 服务器配置
# ===========================================

# 服务器端口
PORT=3003

# 监听地址
# 0.0.0.0 - 监听所有网络接口（生产环境）
# 127.0.0.1 - 仅监听本地（开发环境）
HOST=0.0.0.0

# ===========================================
# 安全配置（可选）
# ===========================================

# 加密密钥（用于加密存储 API 密钥）
# 如果不设置，系统会自动生成一个
# 建议在生产环境设置一个固定的密钥
MEDICAL_APP_SECRET=

# ===========================================
# AI 功能开关（可选）
# ===========================================

# 是否启用 AI 功能
# 可以在 Web 界面中动态修改
AI_ENABLED=true

# 是否使用 AI 生成病例
AI_GENERATE_CASES=true

# 是否使用 AI 生成检查报告
AI_GENERATE_EXAMINATIONS=true

# 是否使用 AI 生成患者描述
AI_GENERATE_DESCRIPTIONS=true

# 是否使用 AI 评分
AI_SCORING=true

# ===========================================
# API 提供商示例配置
# ===========================================

# --- DeepSeek ---
# AI_API_URL=https://api.deepseek.com/v1/chat/completions
# AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AI_MODEL=deepseek-chat

# --- OpenAI ---
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# AI_MODEL=gpt-4

# --- Ollama（本地部署）---
# AI_API_URL=http://localhost:11434/v1/chat/completions
# AI_API_KEY=ollama
# AI_MODEL=qwen2.5

# --- 兼容 OpenAI API 的其他服务 ---
# AI_API_URL=https://your-api-endpoint.com/v1/chat/completions
# AI_API_KEY=your_api_key
# AI_MODEL=your_model_name
